<ui:FluentWindow x:Class="StockSimulator.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:StockSimulator.Views"
                 mc:Ignorable="d"
                 Title="{Binding Title}"
                 Width="1580" Height="940"
                 MinWidth="1200" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <ui:TitleBar Grid.Row="0" Title="股票仿真 K 线生成器"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True" />

        <!-- ===== 左侧导航 + 右侧内容 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航面板 -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="功能" Margin="18,14,0,4" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <Border DockPanel.Dock="Bottom" Margin="10,10,10,14" Padding="12,10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{Binding Workspace.Rules.Symbol}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Style="{StaticResource NavCaption}" Margin="0,2,0,0"
                                       Text="{Binding Workspace.Rules.DisplayName}" />
                            <Border Height="1" Margin="0,8"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="DataHistogram24" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding BarCountText}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="12"
                                           Text="{Binding Workspace.Settings.Period, Converter={StaticResource EnumDisplay}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedIndex="{Binding SelectedTabIndex}"
                             Background="Transparent" BorderThickness="0"
                             Margin="8,0,8,0" Padding="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 内容区：四个视图常驻，按索引切换可见性 -->
            <Grid Grid.Column="1" Margin="12,10,12,10">
                <views:SegmentTabView DataContext="{Binding SegmentTab}"
                                      Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}" />
                <views:ManualDrawTabView DataContext="{Binding DrawTab}"
                                         Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}" />
                <views:BatchTabView DataContext="{Binding BatchTab}"
                                    Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}" />
                <views:ExportTabView DataContext="{Binding ExportTab}"
                                     Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}" />
            </Grid>
        </Grid>

        <!-- ===== 状态栏 + 常驻免责声明 ===== -->
        <Border Grid.Row="2" Padding="14,8"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Disclaimer}" FontSize="11" Margin="18,0,0,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
