<UserControl x:Class="StockSimulator.Controls.KlineCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
             Focusable="True">
    <Grid>
        <sp:WpfPlot x:Name="PlotControl" />

        <!-- 空数据提示 -->
        <Border x:Name="EmptyHint"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="22,14"
                CornerRadius="8">
            <TextBlock Text="暂无K线数据：请在「分段参数」页生成，或在「手绘编辑」页导入 CSV 真实行情"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
