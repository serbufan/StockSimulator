<UserControl x:Class="StockSimulator.Views.SegmentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1400">

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：阶段 / 事件 / 滑点 ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="行情阶段（按顺序首尾相接）" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="阶段名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                                <DataGridTextColumn Header="K线数" Binding="{Binding BarCount, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <DataGridTextColumn Header="漂移" Binding="{Binding Drift, StringFormat={}{0:F4}}" Width="70" />
                                <DataGridTextColumn Header="波动率" Binding="{Binding Volatility, StringFormat={}{0:F4}}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Content="新增" Command="{Binding AddSegmentCommand}" />
                            <ui:Button Content="复制" Command="{Binding CloneSegmentCommand}" />
                            <ui:Button Content="删除" Command="{Binding RemoveSegmentCommand}" Appearance="Danger" />
                            <ui:Button Content="上移" Command="{Binding MoveSegmentUpCommand}" />
                            <ui:Button Content="下移" Command="{Binding MoveSegmentDownCommand}" />
                            <ui:Button Content="载入内置" Command="{Binding LoadDefaultPresetCommand}" />
                            <ui:Button Content="清空" Command="{Binding ClearSegmentsCommand}" Appearance="Danger" />
                        </WrapPanel>

                        <TextBlock Text="{Binding TotalBarsText}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="突发事件（插入到选中阶段）" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding SelectedSegment.Events}" SelectedItem="{Binding SelectedEvent}" Height="150">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="类型" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.EventTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                      BorderThickness="0" Background="Transparent">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="位于第N根" Binding="{Binding AtBarIndex, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="幅度" Binding="{Binding Magnitude, StringFormat={}{0:F3}}" Width="70" />
                                <DataGridTextColumn Header="停牌根数" Binding="{Binding DurationBars, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Content="插入事件" Command="{Binding AddEventCommand}" />
                            <ui:Button Content="删除事件" Command="{Binding RemoveEventCommand}" Appearance="Danger" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="跳空类：幅度为比例（0.03=跳空3%）；除权除息：幅度为每股现金（元）；送股拆股：幅度为缩股比例（0.5=10送10）；停牌：OHLC 拉平且成交量为 0。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="滑点分段（随K线一起导出）" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Slippages}" SelectedItem="{Binding SelectedSlippage}" Height="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="起始#" Binding="{Binding StartIndex, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <DataGridTextColumn Header="结束#" Binding="{Binding EndIndex, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="滑点bp" Binding="{Binding SlippageBps, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <DataGridTextColumn Header="滑点跳" Binding="{Binding SlippageTicks, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Content="新增滑点段" Command="{Binding AddSlippageCommand}" />
                            <ui:Button Content="删除" Command="{Binding RemoveSlippageCommand}" Appearance="Danger" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="A股规则开关" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <CheckBox Content="启用涨跌停" IsChecked="{Binding Rules.EnablePriceLimit}" />
                            <CheckBox Content="成交量按手" IsChecked="{Binding Rules.VolumeInLots}" />
                            <CheckBox Content="价格取整到tick" IsChecked="{Binding Rules.RoundPricesToTick}" />
                        </WrapPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="涨跌停档位" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding LimitModes}" SelectedItem="{Binding Rules.LimitMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="最小报价" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="3" Text="{Binding Rules.TickSize, StringFormat={}{0:F2}}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自定义比例" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding Rules.CustomLimitPct, StringFormat={}{0:P1}}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Rules.LimitDisplay, StringFormat=当前生效：{0}}"
                                       Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= 右：时间轴 / 参数 / 校验 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具条 -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <WrapPanel>
                    <ui:Button Content="生成 K 线" Command="{Binding GenerateCommand}" Appearance="Primary"
                               Icon="{ui:SymbolIcon Symbol=Play24}" />
                    <ui:Button Content="校验合法性" Command="{Binding ValidateCommand}"
                               Icon="{ui:SymbolIcon Symbol=Checkmark24}" />
                    <ui:Button Content="一键修复" Command="{Binding RepairCommand}"
                               Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="快速预设：" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                    <ui:Button Content="上升趋势" Command="{Binding ApplyQuickPresetCommand}" CommandParameter="up" />
                    <ui:Button Content="下跌趋势" Command="{Binding ApplyQuickPresetCommand}" CommandParameter="down" />
                    <ui:Button Content="箱体震荡" Command="{Binding ApplyQuickPresetCommand}" CommandParameter="range" />
                    <ui:Button Content="缩量横盘" Command="{Binding ApplyQuickPresetCommand}" CommandParameter="squeeze" />
                    <ui:Button Content="恐慌急跌" Command="{Binding ApplyQuickPresetCommand}" CommandParameter="crash" />
                </WrapPanel>
            </Border>

            <!-- 时间轴 -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="时间轴（块宽 ∝ 阶段K线数）" Style="{StaticResource SectionTitle}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="48" Margin="0,0,2,0" CornerRadius="3"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                            ToolTip="{Binding Tooltip}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Bars}" Foreground="White" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding RangeText}" Foreground="#F0F4F8" FontSize="9"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding GenerationSummary}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 选中阶段参数 + 全局参数 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding HasSelectedSegment}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="选中阶段参数：" />
                                <Run Text="{Binding SelectedSegment.Name, Mode=OneWay}" />
                            </TextBlock>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="趋势漂移/根" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="-0.02" Maximum="0.02" SmallChange="0.0005"
                                        Value="{Binding SelectedSegment.Drift}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.Drift, StringFormat={}{0:P2}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="波动率/根" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0.001" Maximum="0.06" SmallChange="0.001"
                                        Value="{Binding SelectedSegment.Volatility}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.Volatility, StringFormat={}{0:P2}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="单根涨跌幅上限" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0.01" Maximum="0.3" SmallChange="0.005"
                                        Value="{Binding SelectedSegment.MaxChangePct}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.MaxChangePct, StringFormat={}{0:P0}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="本阶段涨跌停" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="0.3" SmallChange="0.01"
                                        Value="{Binding SelectedSegment.LimitPct}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.LimitPct, StringFormat={}{0:P0}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="跳空概率" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="0.5" SmallChange="0.01"
                                        Value="{Binding SelectedSegment.GapProbability}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.GapProbability, StringFormat={}{0:P0}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="跳空幅度系数" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="3" SmallChange="0.1"
                                        Value="{Binding SelectedSegment.GapScale}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.GapScale, StringFormat={}{0:F2}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="成交量系数" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0.1" Maximum="3" SmallChange="0.05"
                                        Value="{Binding SelectedSegment.VolumeFactor}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.VolumeFactor, StringFormat={}{0:F2}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="阳线偏好" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="-1" Maximum="1" SmallChange="0.05"
                                        Value="{Binding SelectedSegment.BullBias}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.BullBias, StringFormat={}{0:F2}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="均值回归强度" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                        Value="{Binding SelectedSegment.MeanReversion}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.MeanReversion, StringFormat={}{0:F2}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="放量概率" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="0.25" SmallChange="0.01"
                                        Value="{Binding SelectedSegment.VolumeSpikeProbability}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.VolumeSpikeProbability, StringFormat={}{0:P0}}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="地量概率" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="0.25" SmallChange="0.01"
                                        Value="{Binding SelectedSegment.VolumeDryProbability}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding SelectedSegment.VolumeDryProbability, StringFormat={}{0:P0}}" />
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="提示：涨跌停填 0 表示沿用上方 A股规则；正负漂移决定阶段方向；均值回归越大越容易形成箱体/双顶结构。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="生成全局参数" Style="{StaticResource SectionTitle}" />
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="起始价格" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Settings.StartPrice, StringFormat={}{0:F2}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="起始日期" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding Settings.StartDate}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="K线周期" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Settings.Period}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="基准成交量(股)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Settings.BaseVolume}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="随机种子" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Settings.Seed}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="影线强度" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Settings.WickFactor, StringFormat={}{0:F2}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="均值回归窗口" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Settings.MeanReversionWindow}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="量能异动" Style="{StaticResource FieldLabel}" />
                                    <CheckBox Content="启用放量/地量" IsChecked="{Binding Settings.EnableVolumeOutlier}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="相同种子 + 相同参数 = 完全一致的K线（可复现）。修改种子即可得到另一套行情。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 校验结果 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Height="170">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}">
                        <Run Text="约束校验：" />
                        <Run Text="{Binding ValidationSummary, Mode=OneWay}" />
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding Issues}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="级别" Binding="{Binding SeverityDisplay}" Width="60" />
                            <DataGridTextColumn Header="序号" Binding="{Binding BarIndex}" Width="60" />
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeDisplay}" Width="130" />
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="120" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
