<UserControl x:Class="StockSimulator.Views.ManualDrawTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:StockSimulator.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1400">

    <DockPanel Margin="4">

        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="工具：" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}"
                                 BorderThickness="0" Background="Transparent" Padding="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="7,3" />
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Margin="0,0,5,0" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="形态：" Style="{StaticResource FieldLabel}" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern}"
                              DisplayMemberPath="DisplayName" Width="110" Margin="0,0,6,0" />
                    <ui:Button Content="插入形态" Command="{Binding InsertPatternCommand}"
                               Icon="{ui:SymbolIcon Symbol=ShapeUnion24}" />
                    <Border Style="{StaticResource Divider}" />
                    <ui:Button Content="撤销" Command="{Binding UndoCommand}" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" />
                    <ui:Button Content="重做" Command="{Binding RedoCommand}" Icon="{ui:SymbolIcon Symbol=ArrowRedo24}" />
                    <ui:Button Content="删除选中K" Command="{Binding DeleteSelectedCommand}" Appearance="Danger"
                               Icon="{ui:SymbolIcon Symbol=Delete24}" />
                    <Border Style="{StaticResource Divider}" />
                    <ui:Button Content="一键平滑" Command="{Binding SmoothCommand}" Icon="{ui:SymbolIcon Symbol=Broom24}" />
                    <ui:Button Content="叠加噪声" Command="{Binding AddNoiseCommand}" Icon="{ui:SymbolIcon Symbol=Flash24}" />
                    <ui:Button Content="校验" Command="{Binding ValidateCommand}" Icon="{ui:SymbolIcon Symbol=Checkmark24}" />
                    <ui:Button Content="一键修复" Command="{Binding RepairCommand}"
                               Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" />
                    <ui:Button Content="导入CSV" Command="{Binding ImportCsvCommand}" Icon="{ui:SymbolIcon Symbol=ArrowImport24}" />
                    <ui:Button Content="清空" Command="{Binding ClearAllCommand}" Appearance="Danger"
                               Icon="{ui:SymbolIcon Symbol=Delete24}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 状态条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="10,5" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding BarInfoText}" FontFamily="Consolas" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding Canvas.Hint}" Style="{StaticResource HintText}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 画布 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                    Background="White" ClipToBounds="True">
                <controls:KlineCanvasControl DataContext="{Binding Canvas}" />
            </Border>

            <!-- 右侧面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                <StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="画布缩放" Style="{StaticResource SectionTitle}" />
                            <WrapPanel>
                                <ui:Button Content="放大" Command="{Binding Canvas.ZoomCommand}" CommandParameter="in" />
                                <ui:Button Content="缩小" Command="{Binding Canvas.ZoomCommand}" CommandParameter="out" />
                                <ui:Button Content="全部显示" Command="{Binding Canvas.ZoomCommand}" CommandParameter="fit" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="显示成交量" IsChecked="{Binding Canvas.ShowVolume}" />
                                <CheckBox Content="显示标注" IsChecked="{Binding Canvas.ShowAnnotations}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="选中K线 OHLC 精细编辑" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding BarInfoText}" Style="{StaticResource HintText}" Margin="0,0,0,6" />
                            <Grid IsEnabled="{Binding Canvas.HasSelection}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="开" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Margin="0,2,6,2" FontFamily="Consolas"
                                         Text="{Binding Canvas.SelectedBar.Open, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                <TextBlock Grid.Column="2" Text="高" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="3" Margin="0,2,0,2" FontFamily="Consolas"
                                         Text="{Binding Canvas.SelectedBar.High, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />

                                <TextBlock Grid.Row="1" Text="低" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,6,2" FontFamily="Consolas"
                                         Text="{Binding Canvas.SelectedBar.Low, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="收" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,2,0,2" FontFamily="Consolas"
                                         Text="{Binding Canvas.SelectedBar.Close, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}" />

                                <TextBlock Grid.Row="2" Text="量" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,2" FontFamily="Consolas"
                                         Text="{Binding Canvas.SelectedBar.Volume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Text="修改后若 OHLC 关系不合法，可点「一键修复」自动修正最高/最低价。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="绘制参数" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="影线比例" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                        Value="{Binding Canvas.WickRatio}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding Canvas.WickRatio, StringFormat={}{0:F2}}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="趋势线波动" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0.001" Maximum="0.05" SmallChange="0.001"
                                        Value="{Binding Canvas.TrendVolatility}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding Canvas.TrendVolatility, StringFormat={}{0:P2}}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="形态K线数" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="5" Maximum="200" SmallChange="1"
                                        Value="{Binding Canvas.PatternBars}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas"
                                           Text="{Binding Canvas.PatternBars}" />
                            </Grid>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="吸附最小报价" IsChecked="{Binding Canvas.SnapToTick}" />
                                <CheckBox Content="网格吸附" IsChecked="{Binding Canvas.SnapToGrid}" />
                            </WrapPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="网格步长(元)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Canvas.GridStep, StringFormat={}{0:F2}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="K线标注" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding AnnotationText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Margin="6,0,6,0" Text="{Binding AnnotationColor}" />
                                <ui:Button Grid.Column="2" Content="添加" Command="{Binding AddAnnotationCommand}" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Annotations}" Height="110" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding BarIndex, StringFormat=#{0}}"
                                                       Style="{StaticResource HintText}" Margin="6,0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <ui:Button Content="定位" Padding="5,1" FontSize="11"
                                                        Command="{Binding DataContext.JumpToAnnotationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <ui:Button Content="删" Padding="5,1" FontSize="11"
                                                        Command="{Binding DataContext.RemoveAnnotationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="数据加工参数" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="平滑窗口" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding SmoothWindow}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="平滑强度" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                        Value="{Binding SmoothStrength}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="价格噪声σ" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="0.05" SmallChange="0.001"
                                        Value="{Binding NoisePrice}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="量能噪声σ" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="0.6" SmallChange="0.02"
                                        Value="{Binding NoiseVolume}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="校验：" />
                                <Run Text="{Binding ValidationSummary, Mode=OneWay}" />
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding Issues}" Height="130">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="级别" Binding="{Binding SeverityDisplay}" Width="55" />
                                    <DataGridTextColumn Header="序号" Binding="{Binding BarIndex}" Width="50" />
                                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
