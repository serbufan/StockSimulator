<Application x:Class="StockSimulator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StockSimulator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ======== WPF UI（Fluent / WinUI 风格）主题 ======== -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ======== 转换器 ======== -->
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:EnumDisplayConverter x:Key="EnumDisplay" />
            <conv:IndexToVisibilityConverter x:Key="IndexToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />

            <!-- ========
                 说明：Button / TextBox / ComboBox / CheckBox / Slider / DataGrid / ListBox
                 等控件的默认样式全部交给 WPF UI 的 ControlsDictionary，
                 这里只补充本应用自己的语义化样式，颜色一律用动态主题画刷，便于切换深/浅色。
                 ======== -->

            <!-- DataGrid 沿用 WPF UI 外观，只补上「不自动生成列」这一必要设置 -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 卡片容器：Fluent 圆角 + 分层描边 -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- 卡片内的细分隔线 -->
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="NavCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
